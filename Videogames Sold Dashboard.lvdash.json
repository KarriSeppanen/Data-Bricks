{
  "datasets": [
    {
      "name": "e6deb41a",
      "displayName": "Most Global Sales",
      "queryLines": [
        "select name, Platform, Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "order by Global_Sales desc\r\n",
        "limit 10"
      ],
      "catalog": "dataengineering",
      "schema": "videogamesales"
    },
    {
      "name": "d11ba263",
      "displayName": "Video Game Sales by Region Analysis",
      "queryLines": [
        "select\r\n",
        "  'North America' as Continent, sum(NA_Sales) as Total_Sales,\r\n",
        "  (sum(NA_Sales) / sum(Global_Sales) * 100) as Percent_of_Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "union all\r\n",
        "select\r\n",
        "  'Europe' as Continent, sum(EU_Sales) as Total_Sales,\r\n",
        "  (sum(EU_Sales) / sum(Global_Sales) * 100) as Percent_of_Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "union all\r\n",
        "select\r\n",
        "  'Japan' as Continent, sum(JP_Sales) as Total_Sales,\r\n",
        "  (sum(JP_Sales) / sum(Global_Sales) * 100) as Percent_of_Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "union all\r\n",
        "select\r\n",
        "  'Other' as Continent, sum(Other_Sales) as Total_Sales,\r\n",
        "  (sum(Other_Sales) / sum(Global_Sales) * 100) as Percent_of_Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "  "
      ],
      "catalog": "dataengineering",
      "schema": "videogamesales"
    },
    {
      "name": "37410344",
      "displayName": "Total Global Sales compared to Genre",
      "queryLines": [
        "select Genre, sum(Global_Sales) as Total_Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "group by Genre\r\n",
        "order by Total_Global_Sales desc"
      ],
      "catalog": "dataengineering",
      "schema": "videogamesales"
    },
    {
      "name": "75287deb",
      "displayName": "General Sales Each Year",
      "queryLines": [
        "select  Year, sum(Global_Sales) as Total_Global_Sales\r\n",
        "from videogame_sales_csv\r\n",
        "group by Year"
      ],
      "catalog": "dataengineering",
      "schema": "videogamesales"
    },
    {
      "name": "e825e026",
      "displayName": "5 Most popular publishers and their global sales",
      "queryLines": [
        "Select Publisher, sum(Global_Sales) as Global_Total_Sales from \r\n",
        "videogame_sales_csv\r\n",
        "group by Publisher\r\n",
        "order by sum(Global_Sales) desc\r\n",
        "limit 5\r\n"
      ],
      "catalog": "dataengineering",
      "schema": "videogamesales"
    }
  ],
